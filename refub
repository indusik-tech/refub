        return;
      }

      if (brokenNow.length === 0) {
        let pay = currentOrder.reward;
        if (phone.sealApplied) pay += 40;
        const hasCopy = Object.values(phone.parts).some(p => p.quality === "copy");
        if (hasCopy && Math.random() < 0.35) {
          pay -= 60;
          addLog("🤨 Клиент заметил китайскую копию запчасти (-60 $ от чаевых).", "warn");
        } else {
          state.rep += 5;
        }
