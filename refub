<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>iFix & Smash: Ремонт и Краш-Тест Телефонов</title>
  <!-- Telegram Mini Apps SDK -->
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    :root {
      --bg-dark: #0b0e14;
      --bg-panel: #151a24;
      --bg-card: #1d2432;
      --accent: #00e5ff;
      --accent-green: #00e676;
      --accent-warn: #ffab00;
      --accent-red: #ff2a55;
      --text-main: #eef2f7;
      --text-muted: #8b98a9;
      --border: #283246;
    }
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
    }
    body {
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg-dark);
      color: var(--text-main);
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    /* HEADER */
    .top-bar {
      background: rgba(21, 26, 36, 0.96);
      border-bottom: 1px solid var(--border);
      padding: 8px 12px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(8px);
    }
    .stats-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .stat-pill {
      background: var(--bg-card);
      border: 1px solid var(--border);
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .stat-pill.money { color: var(--accent-green); border-color: rgba(0,230,118,0.3); }
    .stat-pill.rep { color: var(--accent); border-color: rgba(0,229,255,0.3); }
    .stat-pill.hype { color: #ff6dff; border-color: rgba(255,109,255,0.3); }
    .cloud-btn {
      background: var(--bg-card);
      color: var(--text-main);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 5px 10px;
      font-size: 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 5px;
      transition: 0.15s;
    }
    .cloud-btn:hover { border-color: var(--accent); }
    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent-warn);
      display: inline-block;
    }
    .dot.ok { background: var(--accent-green); box-shadow: 0 0 6px var(--accent-green); }
    .dot.err { background: var(--accent-red); }

    /* MAIN LAYOUT */
    .main-grid {
      display: grid;
      grid-template-columns: 300px 1fr 310px;
      gap: 12px;
      padding: 12px;
      flex: 1;
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
    }
    @media (max-width: 1050px) {
      .main-grid {
        grid-template-columns: 1fr;
      }
    }

    .panel {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .panel-title {
      font-size: 14px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--text-muted);
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
      padding-bottom: 8px;
      margin: 0;
    }

    /* CLIENT CARD & QUEUE */
    .client-box {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .client-header {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .avatar {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: linear-gradient(135deg, #2b3548, #1a212e);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      border: 1px solid var(--border);
      flex-shrink: 0;
    }
    .client-meta h4 {
      margin: 0 0 2px 0;
      font-size: 15px;
    }
    .client-meta span {
      font-size: 12px;
      color: var(--accent);
      font-weight: 600;
    }
    .speech-bubble {
      background: rgba(0, 0, 0, 0.35);
      border-left: 3px solid var(--accent);
      padding: 8px 10px;
      border-radius: 6px;
      font-size: 13px;
      line-height: 1.35;
      color: #d6e0f0;
    }
    .order-specs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      font-size: 12px;
    }
    .spec-item {
      background: rgba(255,255,255,0.03);
      padding: 5px 8px;
      border-radius: 6px;
    }
    .spec-item b { color: var(--accent-green); }

    /* BUTTONS */
    .btn {
      background: var(--bg-card);
      color: var(--text-main);
      border: 1px solid var(--border);
      padding: 8px 12px;
      border-radius: 9px;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
      transition: 0.15s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    .btn:hover:not(:disabled) {
      border-color: var(--accent);
      transform: translateY(-1px);
    }
    .btn:active:not(:disabled) { transform: translateY(0); }
    .btn:disabled { opacity: 0.45; cursor: not-allowed; }
    .btn-primary {
      background: linear-gradient(135deg, #00b4d8, #0077b6);
      border-color: #00e5ff;
      color: #fff;
    }
    .btn-success {
      background: linear-gradient(135deg, #00c853, #009624);
      border-color: #00e676;
      color: #fff;
    }
    .btn-danger {
      background: linear-gradient(135deg, #ff1744, #b00020);
      border-color: #ff5252;
      color: #fff;
    }
    .btn-stream {
      background: linear-gradient(135deg, #aa00ff, #6200ea);
      border-color: #e040fb;
      color: #fff;
    }

    /* WORKBENCH CENTER */
    .workbench {
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: relative;
    }
    .bench-top-controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      background: var(--bg-card);
      padding: 8px 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
    }
    .temp-gauge {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 700;
    }
    .temp-bar-wrap {
      width: 100px;
      height: 10px;
      background: #0d1117;
      border-radius: 99px;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .temp-bar-fill {
      height: 100%;
      width: 15%;
      background: linear-gradient(90deg, #00e5ff, #00e676, #ffab00, #ff1744);
      transition: width 0.15s;
    }

    /* PHONE TABLE AREA */
    .mat-surface {
      background:
        radial-gradient(circle at center, #192538 0%, #0f1622 100%);
      border: 2px solid #263852;
      border-radius: 16px;
      min-height: 470px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 20px;
      box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.75);
    }
    .mat-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(0, 229, 255, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 229, 255, 0.05) 1px, transparent 1px);
      background-size: 24px 24px;
      pointer-events: none;
    }
    .mat-rulers {
      position: absolute;
      bottom: 8px;
      left: 12px;
      font-size: 11px;
      color: rgba(0, 229, 255, 0.35);
      font-family: monospace;
      pointer-events: none;
    }

    /* PHONE CHASSIS */
    .phone-wrapper {
      position: relative;
      transition: transform 0.12s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .phone-chassis {
      width: 240px;
      height: 430px;
      border-radius: 38px;
      background: linear-gradient(145deg, #2b303a, #161920);
      border: 4px solid #6c7687;
      box-shadow:
        0 20px 45px rgba(0,0,0,0.8),
        inset 0 0 8px rgba(255,255,255,0.18);
      position: relative;
      overflow: hidden;
      transition: width 0.25s ease, border-radius 0.25s ease;
    }
    /* Foldable iPhone Duo wide style */
    .phone-chassis.duo-model {
      width: 380px;
      height: 410px;
      border-radius: 28px;
      border-color: #8294b0;
    }
    @media (max-width: 460px) {
      .phone-chassis.duo-model {
        width: 310px;
        height: 370px;
      }
    }

    /* Fold crease line on Duo */
    .duo-hinge-line {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 8px;
      transform: translateX(-50%);
      background: linear-gradient(90deg, rgba(0,0,0,0.6), rgba(255,255,255,0.15), rgba(0,0,0,0.6));
      z-index: 6;
      pointer-events: none;
      display: none;
    }
    .phone-chassis.duo-model .duo-hinge-line {
      display: block;
    }

    /* EXTERIOR SCREEN LAYER */
    .screen-layer {
      position: absolute;
      inset: 5px;
      border-radius: 32px;
      background: #07090e;
      overflow: hidden;
      z-index: 5;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 14px;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.25s;
    }
    .phone-chassis.duo-model .screen-layer {
      border-radius: 22px;
    }
    .screen-layer.removed {
      transform: translateX(-115%) rotate(-8deg);
      opacity: 0;
      pointer-events: none;
    }
    .screen-layer.powered-on {
      background: linear-gradient(135deg, #1b004b 0%, #004e92 50%, #00d2ff 100%);
    }
    .screen-layer.powered-on.glitch {
      background: repeating-linear-gradient(
        0deg,
        #111 0px,
        #111 4px,
        #ff0055 5px,
        #00ffcc 8px
      );
    }
    /* Dynamic Island / Under-display cutout */
    .dynamic-island {
      width: 68px;
      height: 18px;
      background: #000;
      border-radius: 99px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding-right: 6px;
      border: 1px solid rgba(255,255,255,0.08);
    }
    .camera-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: radial-gradient(circle, #1e40af 20%, #050814 80%);
    }
    .os-ui {
      text-align: center;
      color: #fff;
      opacity: 0;
      transition: 0.25s;
      margin-top: 25px;
    }
    .screen-layer.powered-on .os-ui {
      opacity: 1;
    }
    .os-time {
      font-size: 38px;
      font-weight: 800;
      letter-spacing: -1px;
      text-shadow: 0 2px 10px rgba(0,0,0,0.4);
    }
    .os-sub {
      font-size: 12px;
      opacity: 0.85;
      margin-top: 4px;
    }
    .os-apps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-top: 35px;
      padding: 0 8px;
    }
    .app-icon {
      aspect-ratio: 1;
      border-radius: 10px;
      background: rgba(255,255,255,0.22);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }
    .home-bar {
      width: 85px;
      height: 4px;
      background: rgba(255,255,255,0.6);
      border-radius: 9px;
      margin: 0 auto;
    }

    /* INTERNAL COMPONENTS LAYER */
    .internals-layer {
      position: absolute;
      inset: 6px;
      border-radius: 30px;
      background: #12161f;
      z-index: 2;
      padding: 12px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 95px 155px 75px 1fr;
      gap: 8px;
    }
    .phone-chassis.duo-model .internals-layer {
      border-radius: 20px;
    }
    .part-slot {
      background: #1b2230;
      border: 2px dashed #374663;
      border-radius: 10px;
      padding: 6px;
      position: relative;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: 0.15s;
      font-size: 11px;
    }
    .part-slot:hover {
      border-color: var(--accent);
      background: #212b3d;
    }
    .part-slot.installed {
      border-style: solid;
      border-color: #3b4d6b;
      background: linear-gradient(145deg, #222a3a, #171d28);
    }
    .part-slot.broken {
      border-color: var(--accent-red);
      box-shadow: inset 0 0 12px rgba(255, 42, 85, 0.35);
    }
    .part-slot.good {
      border-color: rgba(0, 230, 118, 0.55);
    }
    .part-name {
      font-weight: 700;
      color: #dbe4f3;
      line-height: 1.15;
    }
    .part-badge {
      font-size: 10px;
      padding: 2px 5px;
      border-radius: 4px;
      align-self: flex-start;
      background: rgba(0,0,0,0.45);
    }
    /* Specific internal positions */
    .slot-camera { grid-column: 1 / 2; grid-row: 1 / 2; background: #18202c; }
    .slot-board  { grid-column: 2 / 3; grid-row: 1 / 3; background: #0e3a2f; }
    .slot-battery{ grid-column: 1 / 2; grid-row: 2 / 4; background: #191d26; }
    .slot-hinge  { grid-column: 2 / 3; grid-row: 3 / 4; }
    .slot-port   { grid-column: 1 / 3; grid-row: 4 / 5; }

    /* Battery connector latch */
    .b-conn-btn {
      position: absolute;
      top: 6px;
      right: 6px;
      font-size: 10px;
      padding: 2px 6px;
      border-radius: 4px;
      background: #283347;
      color: #fff;
      border: 1px solid #4c5d7d;
      z-index: 4;
    }
    .b-conn-btn.connected {
      background: rgba(0, 230, 118, 0.25);
      border-color: var(--accent-green);
      color: var(--accent-green);
    }

    /* Seal / Glue perimeter indicator */
    .seal-frame {
      position: absolute;
      inset: 3px;
      border-radius: 33px;
      border: 3px dashed transparent;
      pointer-events: none;
      z-index: 4;
    }
    .seal-frame.applied {
      border-color: var(--accent);
      box-shadow: inset 0 0 8px rgba(0, 229, 255, 0.4);
    }

    /* Bottom Pentalobe Screws */
    .screws-bar {
      position: absolute;
      bottom: 2px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 36px;
      z-index: 12;
    }
    .screw-dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: radial-gradient(circle, #b0bac9 20%, #464f5e 90%);
      border: 2px solid #202630;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 9px;
      color: #111;
      font-weight: 900;
      transition: 0.2s;
    }
    .screw-dot.unscrewed {
      opacity: 0.25;
      transform: scale(0.7);
      background: #000;
      border-color: var(--accent);
    }

    /* DAMAGE & FX CANVAS OVERLAY */
    #fxCanvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 9;
      pointer-events: none;
    }
    /* Click catcher when using tools on phone */
    .tool-target-overlay {
      position: absolute;
      inset: 0;
      z-index: 10;
      cursor: crosshair;
    }

    /* TOOLBARS */
    .tools-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    @media (max-width: 650px) {
      .tools-section { grid-template-columns: 1fr; }
    }
    .tool-box {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px;
    }
    .tool-box.rage-box {
      border-color: rgba(255, 42, 85, 0.4);
      background: linear-gradient(180deg, rgba(45, 14, 24, 0.7), var(--bg-card));
    }
    .tool-box-header {
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      color: var(--text-muted);
    }
    .rage-box .tool-box-header { color: #ff6e89; }
    .tools-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
      gap: 6px;
    }
    .tool-btn {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      color: var(--text-main);
      border-radius: 8px;
      padding: 7px 8px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: 0.15s;
      text-align: left;
    }
    .tool-btn:hover {
      border-color: var(--accent);
      background: rgba(0, 229, 255, 0.08);
    }
    .tool-btn.active {
      background: rgba(0, 229, 255, 0.18);
      border-color: var(--accent);
      box-shadow: 0 0 12px rgba(0, 229, 255, 0.25);
    }
    .rage-box .tool-btn.active {
      background: rgba(255, 42, 85, 0.25);
      border-color: var(--accent-red);
      box-shadow: 0 0 14px rgba(255, 42, 85, 0.4);
    }

    /* SHOP & INVENTORY RIGHT PANEL */
    .tabs-bar {
      display: flex;
      gap: 6px;
    }
    .tab-btn {
      flex: 1;
      padding: 7px;
      font-size: 12px;
      font-weight: 700;
      background: var(--bg-card);
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: 8px;
      cursor: pointer;
    }
    .tab-btn.active {
      color: var(--text-main);
      border-color: var(--accent);
      background: rgba(0, 229, 255, 0.12);
    }
    .parts-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 430px;
      overflow-y: auto;
      padding-right: 4px;
    }
    .part-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px 10px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .part-card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      font-weight: 700;
    }
    .part-card-actions {
      display: flex;
      gap: 6px;
    }
    .part-card-actions .btn {
      flex: 1;
      padding: 5px 8px;
      font-size: 11px;
    }

    /* LOG CONSOLE */
    .log-box {
      background: #090c11;
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px 10px;
      height: 120px;
      overflow-y: auto;
      font-family: monospace;
      font-size: 12px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .log-entry { line-height: 1.35; }
    .log-entry.info { color: #90caf9; }
    .log-entry.good { color: var(--accent-green); }
    .log-entry.warn { color: var(--accent-warn); }
    .log-entry.bad  { color: var(--accent-red); font-weight: bold; }

    /* SHAKE ANIMATION */
    @keyframes shakeHeavy {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      20% { transform: translate(-10px, 6px) rotate(-3deg); }
      40% { transform: translate(9px, -8px) rotate(3deg); }
      60% { transform: translate(-8px, -4px) rotate(-2deg); }
      80% { transform: translate(7px, 5px) rotate(2deg); }
    }
    .shake {
      animation: shakeHeavy 0.28s ease-in-out;
    }

    /* MODAL */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.78);
      backdrop-filter: blur(5px);
      z-index: 300;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .modal-backdrop.open { display: flex; }
    .modal-card {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 16px;
      max-width: 520px;
      width: 100%;
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-height: 90vh;
      overflow-y: auto;
    }
    .sql-pre {
      background: #080a0f;
            border: 1px solid var(--border);
      padding: 10px;
      border-radius: 8px;
      font-size: 11px;
      color: #a5d6ff;
      overflow-x: auto;
      white-space: pre-wrap;
      user-select: text;
      -webkit-user-select: text;
    }
  </style>
</head>
<body>

  <!-- TOP HEADER -->
  <header class="top-bar">
    <div class="stats-row">
      <div class="stat-pill">🛠️ <span>iFix & Smash</span></div>
      <div class="stat-pill money">💵 <span id="uiMoney">1200</span> $</div>
