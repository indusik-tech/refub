<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>iFix & Smash: Сервисный Центр</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    :root {
      --bg-dark: #0b0e14;
      --bg-panel: #151a24;
      --bg-card: #1d2432;
      --accent: #00e5ff;
      --accent-green: #00e676;
      --accent-warn: #ffab00;
      --accent-red: #ff2a55;
      --text-main: #eef2f7;
      --text-muted: #8b98a9;
      --border: #283246;
    }
    * { box-sizing: border-box; user-select: none; -webkit-user-select: none; }
    body {
      margin: 0; padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg-dark); color: var(--text-main);
      overflow-x: hidden; min-height: 100vh;
      display: flex; flex-direction: column;
    }
    .top-bar {
      background: rgba(21, 26, 36, 0.96);
      border-bottom: 1px solid var(--border);
      padding: 8px 12px;
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px;
      position: sticky; top: 0; z-index: 100; backdrop-filter: blur(8px);
    }
    .stats-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .stat-pill {
      background: var(--bg-card); border: 1px solid var(--border);
      padding: 4px 10px; border-radius: 999px; font-size: 13px; font-weight: 700;
      display: flex; align-items: center; gap: 5px;
    }
    .stat-pill.money { color: var(--accent-green); border-color: rgba(0,230,118,0.3); }
    .stat-pill.rep { color: var(--accent); border-color: rgba(0,229,255,0.3); }
    .cloud-btn {
      background: var(--bg-card); color: var(--text-main); border: 1px solid var(--border);
      border-radius: 8px; padding: 5px 10px; font-size: 12px; cursor: pointer;
      display: flex; align-items: center; gap: 5px;
    }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent-warn); display: inline-block; }
    .dot.ok { background: var(--accent-green); box-shadow: 0 0 6px var(--accent-green); }
    .dot.err { background: var(--accent-red); }

    .main-grid {
      display: grid; grid-template-columns: 300px 1fr 310px;
      gap: 12px; padding: 12px; flex: 1; max-width: 1440px; width: 100%; margin: 0 auto;
    }
    @media (max-width: 1050px) { .main-grid { grid-template-columns: 1fr; } }

    .panel {
      background: var(--bg-panel); border: 1px solid var(--border);
      border-radius: 14px; padding: 12px; display: flex; flex-direction: column; gap: 10px;
    }
    .panel-title {
      font-size: 14px; font-weight: 800; text-transform: uppercase; color: var(--text-muted);
      display: flex; justify-content: space-between; align-items: center;
      border-bottom: 1px solid var(--border); padding-bottom: 8px; margin: 0;
    }
    .client-box {
      background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px;
      padding: 10px; display: flex; flex-direction: column; gap: 8px;
    }
    .client-header { display: flex; align-items: center; gap: 10px; }
    .avatar {
      width: 44px; height: 44px; border-radius: 12px;
      background: linear-gradient(135deg, #2b3548, #1a212e);
      display: flex; align-items: center; justify-content: center; font-size: 24px;
      border: 1px solid var(--border); flex-shrink: 0;
    }
    .client-meta h4 { margin: 0 0 2px 0; font-size: 15px; }
    .client-meta span { font-size: 12px; color: var(--accent); font-weight: 600; }
    .speech-bubble {
      background: rgba(0,0,0,0.35); border-left: 3px solid var(--accent);
      padding: 8px 10px; border-radius: 6px; font-size: 13px; line-height: 1.35; color: #d6e0f0;
    }
    .order-specs { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; font-size: 12px; }
    .spec-item { background: rgba(255,255,255,0.03); padding: 5px 8px; border-radius: 6px; }
    .spec-item b { color: var(--accent-green); }

    .btn {
      background: var(--bg-card); color: var(--text-main); border: 1px solid var(--border);
      padding: 8px 12px; border-radius: 9px; font-weight: 700; font-size: 13px; cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center; gap: 6px; transition: 0.15s;
    }
    .btn:hover { border-color: var(--accent); }
    .btn-primary { background: linear-gradient(135deg, #00b4d8, #0077b6); border-color: #00e5ff; color: #fff; }
    .btn-success { background: linear-gradient(135deg, #00c853, #009624); border-color: #00e676; color: #fff; }
    .btn-danger { background: linear-gradient(135deg, #ff1744, #b00020); border-color: #ff5252; color: #fff; }
    .btn-stream { background: linear-gradient(135deg, #aa00ff, #6200ea); border-color: #e040fb; color: #fff; }

    .workbench { display: flex; flex-direction: column; gap: 10px; position: relative; }
    .bench-top-controls {
      display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px;
      background: var(--bg-card); padding: 8px 12px; border-radius: 10px; border: 1px solid var(--border);
    }
    .temp-gauge { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; }
    .temp-bar-wrap { width: 100px; height: 10px; background: #0d1117; border-radius: 99px; overflow: hidden; border: 1px solid var(--border); }
    .temp-bar-fill { height: 100%; width: 15%; background: linear-gradient(90deg, #00e5ff, #00e676, #ffab00, #ff1744); }

    .mat-surface {
      background: radial-gradient(circle at center, #192538 0%, #0f1622 100%);
      border: 2px solid #263852; border-radius: 16px; min-height: 450px;
      position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 20px;
    }
    .phone-wrapper { position: relative; display: flex; align-items: center; justify-content: center; }
    .phone-chassis {
      width: 240px; height: 420px; border-radius: 36px;
      background: linear-gradient(145deg, #2b303a, #161920);
      border: 4px solid #6c7687; box-shadow: 0 20px 45px rgba(0,0,0,0.8);
      position: relative; overflow: hidden;
    }
    .phone-chassis.duo-model { width: 360px; height: 400px; border-radius: 26px; }

    .screen-layer {
      position: absolute; inset: 5px; border-radius: 30px; background: #07090e;
      z-index: 5; display: flex; flex-direction: column; justify-content: space-between; padding: 14px;
      transition: transform 0.35s ease, opacity 0.25s;
    }
    .screen-layer.removed { transform: translateX(-115%) rotate(-8deg); opacity: 0; pointer-events: none; }
    .screen-layer.powered-on { background: linear-gradient(135deg, #1b004b 0%, #004e92 50%, #00d2ff 100%); }

    .dynamic-island { width: 64px; height: 16px; background: #000; border-radius: 99px; margin: 0 auto; }
    .os-ui { text-align: center; color: #fff; opacity: 0; transition: 0.25s; margin-top: 20px; }
    .screen-layer.powered-on .os-ui { opacity: 1; }
    .home-bar { width: 80px; height: 4px; background: rgba(255,255,255,0.6); border-radius: 9px; margin: 0 auto; }

    .internals-layer {
      position: absolute; inset: 6px; border-radius: 28px; background: #12161f; z-index: 2; padding: 10px;
      display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 90px 145px 70px 1fr; gap: 8px;
    }
    .part-slot {
      background: #1b2230; border: 2px dashed #374663; border-radius: 10px; padding: 6px;
      position: relative; cursor: pointer; display: flex; flex-direction: column; justify-content: space-between; font-size: 11px;
    }
    .part-slot.installed { border-style: solid; border-color: #3b4d6b; background: #222a3a; }
    .part-slot.broken { border-color: var(--accent-red); }
    .part-slot.good { border-color: var(--accent-green); }
    .part-name { font-weight: 700; color: #dbe4f3; }
    .part-badge { font-size: 10px; padding: 2px 5px; border-radius: 4px; background: rgba(0,0,0,0.45); align-self: flex-start; }

    .b-conn-btn {
      position: absolute; top: 6px; right: 6px; font-size: 9px; padding: 2px 5px; border-radius: 4px;
      background: #283347; color: #fff; border: 1px solid #4c5d7d; z-index: 4; cursor: pointer;
    }
    .b-conn-btn.connected { background: rgba(0,230,118,0.25); border-color: var(--accent-green); color: var(--accent-green); }

    .screws-bar { position: absolute; bottom: 2px; left: 50%; transform: translateX(-50%); display: flex; gap: 32px; z-index: 12; }
    .screw-dot {
      width: 12px; height: 12px; border-radius: 50%; background: #b0bac9; border: 2px solid #202630;
      cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 8px; color: #111;
    }
    .screw-dot.unscrewed { opacity: 0.25; background: #000; border-color: var(--accent); }

    #fxCanvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 9; pointer-events: none; }
    .tool-target-overlay { position: absolute; inset: 0; z-index: 10; cursor: crosshair; display: none; }

    .tools-section { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    @media (max-width: 650px) { .tools-section { grid-template-columns: 1fr; } }
    .tool-box { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 10px; }
    .tool-box.rage-box { border-color: rgba(255,42,85,0.4); background: rgba(45,14,24,0.7); }
    .tool-box-header { font-size: 12px; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; display: flex; justify-content: space-between; color: var(--text-muted); }
    .tools-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(105px, 1fr)); gap: 6px; }
    .tool-btn {
      background: rgba(255,255,255,0.04); border: 1px solid var(--border); color: var(--text-main);
      border-radius: 8px; padding: 6px 8px; font-size: 11.5px; font-weight: 600; cursor: pointer; text-align: left;
    }
    .tool-btn.active { background: rgba(0,229,255,0.18); border-color: var(--accent); }
    .rage-box .tool-btn.active { background: rgba(255,42,85,0.25); border-color: var(--accent-red); }

    .tabs-bar { display: flex; gap: 6px; }
    .tab-btn { flex: 1; padding: 7px; font-size: 12px; font-weight: 700; background: var(--bg-card); color: var(--text-muted); border: 1px solid var(--border); border-radius: 8px; cursor: pointer; }
    .tab-btn.active { color: var(--text-main); border-color: var(--accent); background: rgba(0,229,255,0.12); }
    .parts-list { display: flex; flex-direction: column; gap: 8px; max-height: 400px; overflow-y: auto; }
    .part-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 8px 10px; display: flex; flex-direction: column; gap: 6px; }
    .part-card-top { display: flex; justify-content: space-between; align-items: center; font-size: 13px; font-weight: 700; }
    .part-card-actions { display: flex; gap: 6px; }
    .part-card-actions .btn { flex: 1; padding: 5px; font-size: 11px; }

    .log-box {
      background: #090c11; border: 1px solid var(--border); border-radius: 10px; padding: 8px;
      height: 110px; overflow-y: auto; font-family: monospace; font-size: 11.5px; display: flex; flex-direction: column; gap: 3px;
    }
    .log-entry.info { color: #90caf9; }
    .log-entry.good { color: var(--accent-green); }
    .log-entry.warn { color: var(--accent-warn); }
    .log-entry.bad { color: var(--accent-red); font-weight: bold; }

    @keyframes shakeHeavy {
      0%, 100% { transform: translate(0,0); }
      20% { transform: translate(-8px, 5px); }
      40% { transform: translate(8px, -6px); }
      60% { transform: translate(-6px, -3px); }
      80% { transform: translate(6px, 4px); }
    }
    .shake { animation: shakeHeavy 0.25s ease-in-out; }
  </style>
</head>
<body>

  <header class="top-bar">
    <div class="stats-row">
      <div class="stat-pill">🛠️ <span>iFix & Smash</span></div>
      <div class="stat-pill money">💵 <span id="uiMoney">1200</span> $</div>
      <div class="stat-pill rep">⭐ Реп: <span id="uiRep">50</span></div>
      <div class="stat-pill">📱 Починено: <span id="uiRepaired">0</span> | 💥 Снесено: <span id="uiSmashed">0</span></div>
    </div>
    <button class="cloud-btn" onclick="syncSupabase(true)">
      <span class="dot" id="cloudDot"></span>
      <span id="cloudText">Supabase Sync</span>
    </button>
  </header>

  <main class="main-grid">
    <!-- LEFT: ORDERS -->
    <section class="panel">
      <h3 class="panel-title"><span>👤 Клиент</span></h3>
      <div class="client-box">
        <div class="client-header">
          <div class="avatar" id="clientAvatar">🧔🏻</div>
          <div class="client-meta">
            <h4 id="clientName">Артем</h4>
            <span id="phoneModelTitle">iPhone 18 Pro Max</span>
          </div>
        </div>
        <div class="speech-bubble" id="clientSpeech">«Уронил в кальянную, экран вдребезги!»</div>
        <div class="order-specs">
          <div class="spec-item">Награда: <b id="orderReward">450 $</b></div>
        </div>
        <button class="btn btn-success" onclick="deliverPhone()">✅ Выдать телефон</button>
        <div style="display:flex; gap:6px;">
          <button class="btn btn-primary" style="flex:1" onclick="nextCustomer()">⏭️ Следующий</button>
          <button class="btn btn-stream" style="flex:1" onclick="startCrashStream()">📹 Краш-Стрим</button>
        </div>
      </div>

      <h3 class="panel-title" style="margin-top:6px;"><span>🔍 Сканер iDiag</span></h3>
      <div id="diagBox" class="client-box" style="font-size:12px;">Нажми «Прозвонить» для диагностики.</div>
      <button class="btn" style="font-size:11px;" onclick="runDiagnostics()">🔍 Прозвонить плату</button>
    </section>

    <!-- CENTER: WORKBENCH -->
    <section class="workbench">
      <div class="bench-top-controls">
        <div style="display:flex; gap:6px;">
          <button class="btn" id="btnPower" onclick="togglePower()">⚡ Питание: ВЫКЛ</button>
          <button class="btn" onclick="putScreenBack()">📲 Закрыть экран</button>
        </div>
        <div class="temp-gauge">
          <span>🌡️ <b id="tempValue">24°C</b></span>
          <div class="temp-bar-wrap"><div class="temp-bar-fill" id="tempBar" style="width:10%"></div></div>
        </div>
      </div>

      <div class="mat-surface">
        <div class="phone-wrapper" id="phoneWrapper">
          <div class="phone-chassis" id="phoneChassis">
            <div class="internals-layer">
              <div class="part-slot" onclick="handleSlot('camera')">
                <span class="part-name">📸 Камера</span><span class="part-badge" id="b-camera">OK</span>
              </div>
              <div class="part-slot" onclick="handleSlot('board')">
                <span class="part-name" id="l-board">🧠 Плата A20</span><span class="part-badge" id="b-board">OK</span>
              </div>
              <div class="part-slot" onclick="handleSlot('battery')">
                <button class="b-conn-btn connected" id="btnBattConn" onclick="toggleBattery(event)">🔌 АКБ</button>
                <span class="part-name">🔋 АКБ</span><span class="part-badge" id="b-battery">OK</span>
              </div>
              <div class="part-slot" onclick="handleSlot('hinge')">
                <span class="part-name" id="l-hinge">⚙️ Taptic</span><span class="part-badge" id="b-hinge">OK</span>
              </div>
              <div class="part-slot" style="grid-column:1/3;" onclick="handleSlot('port')">
                <span class="part-name">⚡ Порт Type-C</span><span class="part-badge" id="b-port">OK</span>
              </div>
            </div>

            <div class="screen-layer" id="screenLayer" onclick="handleScreenClick(event)">
              <div class="dynamic-island"></div>
              <div class="os-ui"><div style="font-size:32px; font-weight:800;">18:00</div></div>
              <div style="text-align:center; font-size:11px; opacity:0.5;">OLED Дисплей</div>
              <div class="home-bar"></div>
            </div>

            <canvas id="fxCanvas" width="360" height="400"></canvas>
            <div class="tool-target-overlay" id="toolOverlay" onclick="handleOverlayClick(event)"></div>

            <div class="screws-bar">
              <div class="screw-dot" onclick="handleScrew(0, event)">✦</div>
              <div class="screw-dot" onclick="handleScrew(1, event)">✦</div>
            </div>
          </div>
        </div>
      </div>

      <div class="tools-section">
        <div class="tool-box">
          <div class="tool-box-header"><span>Ремонт</span><span id="activeToolLbl" style="color:var(--accent)">Отвертка</span></div>
          <div class="tools-grid">
            <button class="tool-btn active" onclick="setTool('screwdriver')">🪛 Отвертка</button>
            <button class="tool-btn" onclick="setTool('heatgun')">🌡️ Фен</button>
            <button class="tool-btn" onclick="setTool('suction')">🪠 Присоска</button>
            <button class="tool-btn" onclick="setTool('tweezers')">镊 Пинцет</button>
            <button class="tool-btn" onclick="setTool('solder')">♨️ Паяльник</button>
          </div>
        </div>
        <div class="tool-box rage-box">
          <div class="tool-box-header"><span>💥 Разнос</span><span>Краш-Тест</span></div>
          <div class="tools-grid">
            <button class="tool-btn" onclick="setTool('hammer')">🔨 Кувалда</button>
            <button class="tool-btn" onclick="setTool('torch')">🔥 Горелка</button>
            <button class="tool-btn" onclick="setTool('taser')">⚡ Шокер</button>
            <button class="tool-btn" onclick="setTool('drill')">🔩 Дрель</button>
          </div>
        </div>
      </div>

      <div class="log-box" id="logBox"></div>
    </section>

    <!-- RIGHT: SHOP & INVENTORY -->
    <section class="panel">
      <div class="tabs-bar">
        <button class="tab-btn active" id="tabShop" onclick="switchTab('shop')">🛒 Склад запчастей</button>
        <button class="tab-btn" id="tabStream" onclick="switchTab('stream')">📹 Стрим</button>
      </div>
      <div id="shopContent" class="parts-list"></div>
      <div id="streamContent" class="parts-list" style="display:none;">
        <div class="client-box">
          <h4 style="margin:0; color:#e040fb;">Краш-Тест Стрим</h4>
          <p style="font-size:12px; color:var(--text-muted);">Покупай флагманы и уничтожай их в прямом эфире за донаты!</p>
          <button class="btn btn-stream" onclick="buyStreamPhone('iphone18pro', 350)">Купить iPhone 18 Pro (350 $)</button>
          <button class="btn btn-stream" onclick="buyStreamPhone('iphoneduo', 450)">Купить iPhone Duo (450 $)</button>
        </div>
      </div>
    </section>
  </main>

  <script>
    const SUPABASE_REST = "https://qgteoxykoeehjywdfwla.supabase.co/rest/v1/player_saves";
    const SUPABASE_KEY = "sb_publishable_9mX1fh6ASUc7sqiQWRFbdg_bjXzaH20";
    let tgId = "web_dev_" + Math.floor(Math.random()*100000);
    try {
      if(window.Telegram && Telegram.WebApp && Telegram.WebApp.initDataUnsafe?.user?.id) {
        tgId = String(Telegram.WebApp.initDataUnsafe.user.id);
      }
    } catch(e){}

    const PARTS = {
      screen: {name: "OLED Дисплей", cost: 120},
      battery: {name: "АКБ Li-Ion", cost: 60},
      board: {name: "Плата A20 Pro", cost: 180},
      camera: {name: "Камера Pro", cost: 90},
      hinge: {name: "Шарнир / Taptic", cost: 70},
      port: {name: "Порт Type-C", cost: 40}
    };

    let state = {
      money: 1200, rep: 50, repaired: 0, smashed: 0,
      inventory: {screen: 2, battery: 2, board: 1, camera: 1, hinge: 1, port: 2}
    };

    let activeTool = "screwdriver";
    let phone = null;
    let currentOrder = null;

    function playSound(type) {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
            osc.connect(g); g.connect(ctx.destination);
        if(type==='pop') { osc.frequency.setValueAtTime(300, ctx.currentTime); osc.frequency.exponentialRampToValueAtTime(600, ctx.currentTime+0.1); }
        else if(type==='smash') { osc.type='square'; osc.frequency.setValueAtTime(100, ctx.currentTime); osc.frequency.exponentialRampToValueAtTime(30, ctx.currentTime+0.2); }
        else { osc.frequency.setValueAtTime(440, ctx.currentTime); }
        g.gain.setValueAtTime(0.1, ctx.currentTime);
        g.gain.linearRampToValueAtTime(0.01, ctx.currentTime+0.15);
        osc.start(); osc.stop(ctx.currentTime+0.15);
      } catch(e){}
    }

    function createPhone(model = "iphone18pro", broken = ["screen"]) {
      const parts = {};
      Object.keys(PARTS).forEach(k => {
        parts[k] = { installed: true, status: broken.includes(k) ? "broken" : "ok" };
      });
      return {
        title: model === "iphoneduo" ? "iPhone Duo (Складной)" : "iPhone 18 Pro Max",
        isDuo: model === "iphoneduo",
        poweredOn: false, screws: [true, true], temp: 24,
        screenRemoved: false, batteryConnected: true,
        smashHits: 0, parts
      };
    }

    function nextCustomer() {
      phone = createPhone("iphone18pro", ["screen", Math.random() > 0.5 ? "battery" : "board"]);
      currentOrder = { name: "Артем", avatar: "🧔🏻", reward: 450, speech: "Экран в паутину и не заряжается, выручай!" };
      renderAll();
      addLog("👤 Новый клиент в сервисе.", "info");
    }

    function startCrashStream() {
      phone = createPhone("iphone18pro", []);
      phone.poweredOn = true;
      currentOrder = { name: "Зрители", avatar: "📹", reward: 0, speech: "Краш-стрим запущен! Разнеси трубу!" };
      renderAll();
      addLog("🎥 Запущен краш-стрим!", "warn");
    }

    function buyStreamPhone(model, cost) {
      if(state.money < cost) { addLog("❌ Не хватает денег!", "bad"); return; }
      state.money -= cost;
      phone = createPhone(model, []);
      phone.poweredOn = true;
      currentOrder = { name: "Зрители", avatar: "📹", reward: 0, speech: "Новый аппарат на уничтожение!" };
      renderAll();
      addLog("🎥 Куплен новый смартфон для стрима!", "good");
    }

    function setTool(t) {
      activeTool = t;
      document.querySelectorAll(".tool-btn").forEach(b => b.classList.toggle("active", b.textContent.toLowerCase().includes(t)));
      document.getElementById("activeToolLbl").textContent = t;
      document.getElementById("toolOverlay").style.display = (phone?.screenRemoved || ['hammer','torch','taser','drill'].includes(t)) ? "block" : "none";
    }

    function togglePower() {
      if(!phone) return;
      phone.poweredOn = !phone.poweredOn;
      playSound('pop');
      renderWorkbench();
    }

    function handleScrew(idx, ev) {
      ev.stopPropagation();
      if(activeTool !== 'screwdriver') { addLog("🪛 Выберите отвертку!", "warn"); return; }
      phone.screws[idx] = !phone.screws[idx];
      playSound('pop');
      renderWorkbench();
    }

    function handleOverlayClick(ev) {
      if(!phone) return;
      const rect = ev.currentTarget.getBoundingClientRect();
      const x = ev.clientX - rect.left, y = ev.clientY - rect.top;

      if(['hammer', 'torch', 'taser', 'drill'].includes(activeTool)) {
        phone.smashHits++;
        phone.parts.screen.status = "destroyed";
        playSound('smash');
        state.money += 45;
        state.smashed++;
        addLog("💥 Жесткий удар по телефону! Донат +45 $", "bad");
        renderAll();
        return;
      }

      if(activeTool === 'heatgun') {
        phone.temp = Math.min(200, phone.temp + 20);
        playSound('pop');
        renderWorkbench();
      } else if(activeTool === 'suction') {
        if(phone.screws[0] || phone.screws[1]) { addLog("⚠️ Выкрутите нижние винты!", "warn"); return; }
        phone.screenRemoved = true;
        playSound('pop');
        addLog("🪠 Экран снят.", "good");
        renderWorkbench();
      }
    }

    function handleSlot(k) {
      if(!phone || !phone.screenRemoved) { addLog("⚠️ Сначала снимите экран!", "warn"); return; }
      const p = phone.parts[k];
      if(activeTool === 'tweezers') {
        if(p.installed) { p.installed = false; addLog(`Снят узел ${k}`, "info"); }
        else if(state.inventory[k] > 0) {
          state.inventory[k]--; p.installed = true; p.status = 'ok';
          addLog(`Установлен новый узел ${k}`, "good");
        } else { addLog("❌ Нет детали на складе!", "bad"); }
      } else if(activeTool === 'solder' && (k==='board'||k==='port')) {
        p.status = 'ok'; addLog("♨️ Успешная пайка!", "good");
      }
      renderWorkbench();
    }

    function toggleBattery(ev) {
      ev.stopPropagation();
      phone.batteryConnected = !phone.batteryConnected;
      renderWorkbench();
    }

    function putScreenBack() {
      if(!phone) return;
      phone.screenRemoved = false;
      addLog("📲 Дисплей установлен на место.", "info");
      renderWorkbench();
    }

    function runDiagnostics() {
      if(!phone) return;
      let report = Object.keys(phone.parts).map(k => `${k}: ${phone.parts[k].status}`).join(" | ");
      document.getElementById("diagBox").textContent = report;
      addLog("🔍 Диагностика завершена.", "info");
    }

    function deliverPhone() {
      if(!phone) return;
      if(phone.screenRemoved || !phone.screws[0] || !phone.screws[1]) {
        addLog("⚠️ Соберите телефон перед выдачей (закрутите винты и поставьте экран)!", "warn");
        return;
      }
      state.money += currentOrder.reward;
      state.repaired++;
      playSound('pop');
      addLog(`🎉 Телефон успешно починен! Получено ${currentOrder.reward} $`, "good");
      nextCustomer();
      renderAll();
      syncSupabase(false);
    }

    function buyPart(k) {
      const cost = PARTS[k].cost;
      if(state.money < cost) { addLog("❌ Не хватает денег!", "bad"); return; }
      state.money -= cost;
      state.inventory[k] = (state.inventory[k] || 0) + 1;
      playSound('pop');
      addLog(`🛒 Куплена деталь: ${PARTS[k].name}`, "good");
      renderAll();
    }

    function switchTab(tab) {
      document.getElementById("tabShop").classList.toggle("active", tab==='shop');
      document.getElementById("tabStream").classList.toggle("active", tab==='stream');
      document.getElementById("shopContent").style.display = tab==='shop' ? 'flex' : 'none';
      document.getElementById("streamContent").style.display = tab==='stream' ? 'flex' : 'none';
    }

    function renderWorkbench() {
      if(!phone) return;
      document.getElementById("tempValue").textContent = phone.temp + "°C";
      document.getElementById("tempBar").style.width = Math.min(100, (phone.temp/200)*100) + "%";
      document.getElementById("btnPower").textContent = phone.poweredOn ? "⚡ Питание: ВКЛ" : "⚡ Питание: ВЫКЛ";
      document.getElementById("screenLayer").classList.toggle("removed", phone.screenRemoved);
      document.getElementById("screenLayer").classList.toggle("powered-on", phone.poweredOn);
      document.getElementById("toolOverlay").style.display = phone.screenRemoved ? "block" : "none";

      document.querySelectorAll(".screw-dot").forEach((el, i) => {
        el.classList.toggle("unscrewed", !phone.screws[i]);
      });

      Object.keys(phone.parts).forEach(k => {
        const badge = document.getElementById(`b-${k}`);
        if(badge) {
          const p = phone.parts[k];
          badge.textContent = !p.installed ? "ПУСТО" : p.status === "ok" ? "OK" : "ЛОМ";
          badge.style.color = p.status === "ok" ? "var(--accent-green)" : "var(--accent-red)";
        }
      });
    }

    function renderShop() {
      const sc = document.getElementById("shopContent");
      sc.innerHTML = Object.keys(PARTS).map(k => `
        <div class="part-card">
          <div class="part-card-top">
            <span>${PARTS[k].name}</span>
            <span style="font-size:11px; color:var(--accent)">На складе: ${state.inventory[k]} шт.</span>
          </div>
          <button class="btn btn-primary" onclick="buyPart('${k}')">Купить за ${PARTS[k].cost} $</button>
        </div>
      `).join('');
    }

    function renderAll() {
      document.getElementById("uiMoney").textContent = state.money;
      document.getElementById("uiRep").textContent = state.rep;
      document.getElementById("uiRepaired").textContent = state.repaired;
      document.getElementById("uiSmashed").textContent = state.smashed;
      if(currentOrder) {
        document.getElementById("clientAvatar").textContent = currentOrder.avatar;
        document.getElementById("clientName").textContent = currentOrder.name;
        document.getElementById("clientSpeech").textContent = currentOrder.speech;
        document.getElementById("orderReward").textContent = currentOrder.reward + " $";
      }
      renderWorkbench();
      renderShop();
    }

    function addLog(msg, type="info") {
      const box = document.getElementById("logBox");
      const div = document.createElement("div");
      div.className = `log-entry ${type}`;
      div.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
      box.prepend(div);
    }

    async function syncSupabase(manual = false) {
      try {
        const res = await fetch(`${SUPABASE_REST}?on_conflict=tg_id`, {
          method: "POST",
          headers: { "apikey": SUPABASE_KEY, "Authorization": "Bearer "+SUPABASE_KEY, "Content-Type": "application/json", "Prefer": "resolution=merge-duplicates" },
          body: JSON.stringify({ tg_id: tgId, money: state.money, rep: state.rep, state_json: state })
        });
        if(res.ok) {
          document.getElementById("cloudDot").className = "dot ok";
          document.getElementById("cloudText").textContent = "Облако ОК";
          if(manual) addLog("☁️ Прогресс сохранен в Supabase!", "good");
        }
      } catch(e) {
        document.getElementById("cloudDot").className = "dot err";
        if(manual) addLog("⚠️ Ошибка синхронизации с облаком", "bad");
      }
    }

    window.addEventListener("DOMContentLoaded", () => {
      nextCustomer();
      syncSupabase(false);
    });
  </script>
</body>
</html>
