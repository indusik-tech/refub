    /********************************************************************
     * 6. "ХУЯРИТЬ ТЕЛЕФОНЫ" — SMASH, BURN, TASER & DRILL ENGINE
     ********************************************************************/
    function applyRageTool(tool, x, y) {
      const wrap = document.getElementById("phoneWrapper");
      wrap.classList.remove("shake");
      void wrap.offsetWidth;
      wrap.classList.add("shake");

      const partKeys = Object.keys(phone.parts);

      if (tool === "hammer") {
        phone.smashHits++;
        phone.parts.screen.status = "destroyed";
        const randomPart = partKeys[Math.floor(Math.random() * partKeys.length)];
        phone.parts[randomPart].status = "destroyed";
        playSound("smash");
        drawCrack(x, y, 7);
        earnStreamDonation(45, "🔨 Мощный удар кувалдой!");
        addLog(`🔨 ХРЯСЬ! Удар кувалдой разнес экран и повредил узел «${PART_TYPES[randomPart].name}»!`, "bad");
      } else if (tool === "torch") {
        phone.burnLevel++;
        phone.temp = Math.min(350, phone.temp + 55);
        phone.parts.screen.status = "destroyed";
        playSound("solder");
        drawBurn(x, y, 36);
        earnStreamDonation(55, "🔥 Прожарка газовой горелкой!");

        if (phone.temp >= 220 && !phone.batteryExploded) {
          phone.batteryExploded = true;
          Object.keys(phone.parts).forEach(k => (phone.parts[k].status = "destroyed"));
          playSound("boom");
          drawExplosion();
          earnStreamDonation(220, "💣 ЭПИЧНЫЙ ВЗРЫВ ЛИТИЕВОЙ БАТАРЕИ В ЭФИРЕ!");
          addLog("💣 БУУУМ! От перегрева горелкой (>220°C) взорвался литиевый аккумулятор! Телефон в тотал!", "bad");
        } else {
          addLog(`🔥 Горелка плавит корпус и матрицу! Температура: ${phone.temp}°C.`, "bad");
        }
      } else if (tool === "taser") {
        phone.taserHits++;
        phone.parts.board.status = "destroyed";
        phone.parts.port.status = "destroyed";
        phone.poweredOn = true;
        playSound("zap");
        drawLightning(x, y);
        earnStreamDonation(65, "⚡ Разряд 10,000 Вольт в плату!");
        addLog("⚡ БЗЗЗТ! Разряд шокера выжег процессор A20 Pro и контроллер питания!", "bad");
      } else if (tool === "drill") {
        phone.drillHoles++;
        phone.parts.screen.status = "destroyed";
        phone.parts.battery.status = "destroyed";
        playSound("screw");
        drawDrillHole(x, y);
        earnStreamDonation(75, "🔩 Сквозная дырка дрелью!");
        addLog("🔩 ВЖЖЖ! Ты просверлил сквозную дыру прямо через дисплей и корпус!", "bad");
      }

      if (phone.smashHits + phone.drillHoles + phone.taserHits + phone.burnLevel === 1) {
        state.smashed++;
      }

      renderAll();
      saveLocal();
    }

    function earnStreamDonation(baseAmount, reason) {
      state.hype += 12;
      if (phone.isStreamMode) {
        const bonus = baseAmount + Math.floor(Math.random() * 35);
        state.money += bonus;
        addLog(`💸 ДОНАТ СО СТРИМА (+${bonus} $): «${reason}»`, "good");
      }
    }

    /********************************************************************
     * 7. DELIVER ORDER TO CUSTOMER
     ********************************************************************/
    function deliverPhone() {
      if (!phone || !currentOrder) return;

      if (phone.isStreamMode) {
        addLog("🎥 Этот телефон куплен для Краш-Стрима! Жми «Следующий клиент», когда наиграешься.", "info");
        return;
      }

      const totalRage = phone.smashHits + phone.drillHoles + phone.taserHits + phone.burnLevel;
      const brokenNow = Object.keys(phone.parts).filter(
        k => !phone.parts[k].installed || phone.parts[k].status !== "ok"
      );

      if (totalRage > 0) {
        state.rep = Math.max(0, state.rep - 10);
        const viralBonus = 95;
        state.money += viralBonus;
        playSound("boom");
        currentOrder.speech =
          "«ТЫ ЧЕ НАТВОРИЛ, ПСИХ?! Я принес телефон в ремонт, а ты расхерачил его кувалдой и горелкой!! Я выкладываю это в ТГ-канал!»";
        addLog(
          `🤬 Клиент в шоке от разнесенного телефона (-10 Репутации), но ролик залетел в реки (+${viralBonus} $ с просмотров)!`,
          "warn"
        );
        renderAll();
        saveToSupabase(false);
        return;
      }

      if (phone.screenRemoved || !phone.screws[0] || !phone.screws[1] || !phone.batteryConnected) {
