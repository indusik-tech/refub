        playSound("cash");
        currentOrder.speech = `«Ебать ты волшебник! Мой ${phone.title} работает как из коробки! Держи ${pay} $!»`;
        addLog(`🎉 Заказ идеально выполнен! Получено ${pay} $ и +5 к Репутации.`, "good");
        renderAll();
        saveToSupabase(false);
      } else {
                state.rep = Math.max(0, state.rep - 5);
        addLog(
          `❌ Клиент недоволен! Остались неисправные узлы (${brokenNow.map(k => PART_TYPES[k].name).join(", ")}).`,
          "bad"
        );
        renderAll();
      }
    }

    /********************************************************************
     * 8. CANVAS PROCEDURAL DAMAGE FX
     ********************************************************************/
    const canvas = document.getElementById("fxCanvas");
    const ctx = canvas.getContext("2d");

    function clearCanvasFX() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    }

    function drawCrack(cx, cy, rays = 6) {
      ctx.save();
      ctx.strokeStyle = "rgba(235, 245, 255, 0.85)";
      ctx.lineWidth = 1.6;
      for (let i = 0; i < rays; i++) {
        let angle = (Math.PI * 2 * i) / rays + (Math.random() - 0.5) * 0.5;
        let px = cx;
        let py = cy;
        ctx.beginPath();
        ctx.moveTo(px, py);
        const steps = 5 + Math.floor(Math.random() * 6);
        for (let s = 0; s < steps; s++) {
          angle += (Math.random() - 0.5) * 0.45;
          px += Math.cos(angle) * (12 + Math.random() * 18);
          py += Math.sin(angle) * (12 + Math.random() * 18);
          ctx.lineTo(px, py);
        }
        ctx.stroke();
      }
      ctx.fillStyle = "rgba(255,255,255,0.6)";
      ctx.beginPath();
      ctx.arc(cx, cy, 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawBurn(cx, cy, radius = 32) {
      ctx.save();
      const grad = ctx.createRadialGradient(cx, cy, 2, cx, cy, radius);
      grad.addColorStop(0, "rgba(255, 120, 0, 0.85)");
      grad.addColorStop(0.35, "rgba(20, 15, 10, 0.92)");
      grad.addColorStop(1, "rgba(0, 0, 0, 0)");
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawDrillHole(cx, cy) {
      ctx.save();
      ctx.fillStyle = "#8a99ad";
      ctx.beginPath();
      ctx.arc(cx, cy, 13, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = "#05070a";
      ctx.beginPath();
      ctx.arc(cx, cy, 9, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
      drawCrack(cx, cy, 4);
    }

    function drawLightning(cx, cy) {
      ctx.save();
      ctx.strokeStyle = "#00f0ff";
      ctx.shadowColor = "#00f0ff";
      ctx.shadowBlur = 10;
      ctx.lineWidth = 2.2;
      for (let i = 0; i < 4; i++) {
        ctx.beginPath();
        let x = cx, y = cy;
        ctx.moveTo(x, y);
        for (let j = 0; j < 6; j++) {
          x += (Math.random() - 0.5) * 55;
          y += (Math.random() - 0.5) * 55;
          ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
      ctx.restore();
    }

    function drawExplosion() {
      drawBurn(190, 210, 150);
      drawCrack(190, 210, 14);
    }

    setInterval(() => {
      if (phone && phone.temp > 24) {
        phone.temp = Math.max(24, phone.temp - 2);
        renderTempGauge();
      }
    }, 900);

    /********************************************************************
     * 9. UI RENDERING
     ********************************************************************/
    function renderTempGauge() {
      if (!phone) return;
      document.getElementById("tempValue").textContent = `${phone.temp}°C`;
      const pct = Math.min(100, ((phone.temp - 20) / 220) * 100);
      document.getElementById("tempBar").style.width = `${pct}%`;
    }

    function renderWorkbenchState() {
      if (!phone) return;
      renderTempGauge();

      const chassis = document.getElementById("phoneChassis");
      chassis.classList.toggle("duo-model", phone.isDuo);

      const overlay = document.getElementById("toolOverlay");
      const rageActive = ["hammer", "torch", "taser", "drill"].includes(activeTool);
      overlay.style.display = (!phone.screenRemoved || rageActive) ? "block" : "none";

      const scr = document.getElementById("screenLayer");
      scr.classList.toggle("removed", phone.screenRemoved);
      scr.classList.toggle("powered-on", phone.poweredOn && phone.parts.screen.status === "ok");
      scr.classList.toggle("glitch", phone.poweredOn && phone.parts.screen.status !== "ok");

      document.getElementById("screenHintLabel").textContent =
        phone.isDuo ? "Dual Foldable OLED (iPhone Duo)" : "Super Retina XDR OLED (iPhone 18 Pro)";

      document.getElementById("btnPower").textContent = phone.poweredOn ? "⚡ Питание: ВКЛ" : "⚡ Питание: ВЫКЛ";
      document.getElementById("sealFrame").classList.toggle("applied", phone.sealApplied);

      document.getElementById("screwLeft").classList.toggle("unscrewed", !phone.screws[0]);
      document.getElementById("screwRight").classList.toggle("unscrewed", !phone.screws[1]);

      const bBtn = document.getElementById("btnBattConn");
      bBtn.classList.toggle("connected", phone.batteryConnected);
      bBtn.textContent = phone.batteryConnected ? "🔌 Клемма: ВКЛ" : "🔌 Клемма: ОТКЛ";

      const m = PHONE_MODELS[phone.modelKey];
      document.getElementById("label-board").textContent = m.boardLabel;
      document.getElementById("label-hinge").textContent = m.hingeLabel;

      ["camera", "board", "battery", "hinge", "port"].forEach(k => {
        const p = phone.parts[k];
        const badge = document.getElementById(`badge-${k}`);
        const slotEl = badge.parentElement;
        slotEl.classList.remove("installed", "broken", "good");

        if (!p.installed) {
          badge.textContent = "СНЯТО (Пусто)";
          badge.style.color = "#ffab00";
        } else {
          slotEl.classList.add("installed");
          if (p.status === "ok") {
            slotEl.classList.add("good");
            badge.textContent = p.quality === "oem" ? "ИСПРАВНО (OEM)" : "ИСПРАВНО (Копия)";
            badge.style.color = "#00e676";
          } else {
            slotEl.classList.add("broken");
            badge.textContent =
              p.status === "destroyed"
                ? "💥 В ТРУХУ!"
                : (k === "board" || k === "port")
                  ? "⚠️ СЛОМАН (Пайка/Замена)"
                  : "⚠️ СЛОМАН (Под замену)";
            badge.style.color = "#ff2a55";
          }
        }
      });
    }

    function renderDiagnostics() {
      const box = document.getElementById("diagBox");
      if (!phone) return;
      if (!phone.diagnosed) {
        box.innerHTML = `<div style="color:var(--text-muted)">Нажми «Прозвонить», чтобы увидеть точный отчет по всем модулям ${phone.title}.</div>`;
        return;
      }
      const rows = Object.keys(PART_TYPES).map(k => {
        const p = phone.parts[k];
        const st = !p.installed
          ? `<b style="color:var(--accent-warn)">СНЯТ</b>`
          : p.status === "ok"
            ? `<b style="color:var(--accent-green)">ОК</b>`
            : `<b style="color:var(--accent-red)">НЕИСПРАВЕН</b>`;
        return `<div style="display:flex; justify-content:space-between;"><span>${PART_TYPES[k].name}:</span> ${st}</div>`;
      });
      box.innerHTML = rows.join("");
    }

    function renderShopAndInventory() {
      const container = document.getElementById("tabShopContent");
      container.innerHTML = Object.keys(PART_TYPES)
        .map(k => {
          const info = PART_TYPES[k];
          const oemCount = state.inventory[`${k}_oem`] || 0;
          const copyCount = state.inventory[`${k}_copy`] || 0;
          return `
            <div class="part-card">
              <div class="part-card-top">
                <span>${info.name}</span>
                <span style="font-size:11px; color:var(--accent)">
                  Склад: OEM (${oemCount}) | Копия (${copyCount})
                </span>
              </div>
              <div class="part-card-actions">
                <button class="btn btn-primary" onclick="buyPart('${k}', 'oem', ${info.oemCost})">
                  + Оригинал (${info.oemCost} $)
                </button>
                <button class="btn" onclick="buyPart('${k}', 'copy', ${info.copyCost})">
                  + Копия Алик (${info.copyCost} $)
                </button>
              </div>
            </div>
          `;
        })
        .join("");

      const qBox = document.getElementById("streamQuests");
      if (qBox && phone) {
        qBox.innerHTML = `
          <div>🔨 Ударов кувалдой по аппарату: <b>${phone.smashHits}</b></div>
          <div>🔩 Просверлено дырок дрелью: <b>${phone.drillHoles}</b></div>
          <div>⚡ Ударов шокером 220В: <b>${phone.taserHits}</b></div>
          <div>💣 Статус батареи: <b>${phone.batteryExploded ? "ВЗОРВАНА 🔥" : "Целая (грей Горелкой >220°C)"}</b></div>
        `;
      }
    }

    function buyPart(partKey, quality, cost) {
      if (state.money < cost) {
        addLog(`❌ Недостаточно средств! Нужно ${cost} $.`, "bad");
        return;
      }
      state.money -= cost;
      const invKey = `${partKey}_${quality}`;
      state.inventory[invKey] = (state.inventory[invKey] || 0) + 1;
      playSound("cash");
      addLog(`🛒 Закуплена деталь: ${PART_TYPES[partKey].name} (${quality === "oem" ? "OEM" : "Копия"}).`, "good");
      renderAll();
      saveLocal();
    }

    function switchRightTab(tab) {
      document.getElementById("tabBtnShop").classList.toggle("active", tab === "shop");
      document.getElementById("tabBtnStream").classList.toggle("active", tab === "stream");
      document.getElementById("tabShopContent").style.display = tab === "shop" ? "flex" : "none";
      document.getElementById("tabStreamContent").style.display = tab === "stream" ? "flex" : "none";
    }

    function renderAll() {
      document.getElementById("uiMoney").textContent = state.money;
      document.getElementById("uiRep").textContent = state.rep;
      document.getElementById("uiHype").textContent = state.hype;
      document.getElementById("uiRepaired").textContent = state.repaired;
      document.getElementById("uiSmashed").textContent = state.smashed;

      if (currentOrder && phone) {
        document.getElementById("clientAvatar").textContent = currentOrder.avatar;
        document.getElementById("clientName").textContent = currentOrder.clientName;
        document.getElementById("phoneModelTitle").textContent = phone.title;
        document.getElementById("clientSpeech").textContent = currentOrder.speech;
        document.getElementById("orderReward").textContent =
          phone.isStreamMode ? "Донаты за удары" : `${currentOrder.reward} $`;
        document.getElementById("orderModeLabel").textContent =
          phone.isStreamMode ? "🎥 КРАШ-СТРИМ" : "🛠️ Ремонт";
      }

      renderWorkbenchState();
      renderDiagnostics();
      renderShopAndInventory();
    }

    function addLog(msg, level = "info") {
      const box = document.getElementById("logBox");
      const div = document.createElement("div");
      div.className = `log-entry ${level}`;
      const time = new Date().toLocaleTimeString("ru-RU", { hour: "2-digit", minute: "2-digit", second: "2-digit" });
      div.textContent = `[${time}] ${msg}`;
      box.prepend(div);
    }

    /********************************************************************
     * 10. SUPABASE REST API + LOCALSTORAGE PERSISTENCE
     ********************************************************************/
    function setCloudIndicator(status, text) {
      const dot = document.getElementById("cloudDot");
      const label = document.getElementById("cloudText");
      const modalStatus = document.getElementById("modalSyncStatus");
      dot.className = "dot " + (status === "ok" ? "ok" : status === "err" ? "err" : "");
      label.textContent = text;
      if (modalStatus) modalStatus.textContent = text;
    }

    function saveLocal() {
      try {
        localStorage.setItem("ifix_smash_save_v1", JSON.stringify(state));
      } catch (e) {}
    }

    function loadLocal() {
      try {
        const raw = localStorage.getItem("ifix_smash_save_v1");
        if (raw) {
          const parsed = JSON.parse(raw);
          state = { ...state, ...parsed, inventory: { ...state.inventory, ...(parsed.inventory || {}) } };
        }
      } catch (e) {}
    }

    async function saveToSupabase(manual = false) {
      saveLocal();
      setCloudIndicator("warn", "Синхронизация...");
      try {
        const payload = {
          tg_id: String(tgUser.id),
          username: tgUser.username,
          money: state.money,
          rep: state.rep,
          smashed: state.smashed,
          repaired: state.repaired,
          state_json: state,
          updated_at: new Date().toISOString()
        };

        const res = await fetch(`${SUPABASE_REST_URL}/${SUPABASE_TABLE}?on_conflict=tg_id`, {
          method: "POST",
          headers: {
            "apikey": SUPABASE_KEY,
            "Authorization": `Bearer ${SUPABASE_KEY}`,
            "Content-Type": "application/json",
            "Prefer": "resolution=merge-duplicates,return=minimal"
          },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          setCloudIndicator("ok", "Облако ОК");
          if (manual) addLog("☁️ Прогресс успешно сохранен в Supabase по твоему Telegram ID!", "good");
        } else {
          const errText = await res.text();
          setCloudIndicator("err", "Локально (Создай SQL)");
          if (manual) {
            addLog(`⚠️ Ответ Supabase (${res.status}): Убедись, что выполнил SQL-скрипт из окна «Облако».`, "warn");
          }
          console.warn("Supabase save warning:", errText);
        }
      } catch (err) {
        setCloudIndicator("err", "Офлайн-сейв");
        if (manual) addLog("⚠️ Ошибка сети при подключении к Supabase. Прогресс сохранен локально.", "warn");
      }
    }

    async function loadFromSupabase(manual = false) {
      loadLocal();
      setCloudIndicator("warn", "Загрузка...");
      try {
        const url = `${SUPABASE_REST_URL}/${SUPABASE_TABLE}?tg_id=eq.${encodeURIComponent(tgUser.id)}&select=*`;
        const res = await fetch(url, {
          method: "GET",
          headers: {
            "apikey": SUPABASE_KEY,
            "Authorization": `Bearer ${SUPABASE_KEY}`
          }
        });

        if (res.ok) {
          const rows = await res.json();
          if (rows && rows.length > 0 && rows[0].state_json) {
            const cloudState = rows[0].state_json;
            state = {
              ...state,
              ...cloudState,
              inventory: { ...state.inventory, ...(cloudState.inventory || {}) }
            };
            saveLocal();
            renderAll();
            setCloudIndicator("ok", "Облако ОК");
            addLog(`☁️ Загружено сохранение из Supabase для аккаунта @${tgUser.username}!`, "good");
          } else {
            setCloudIndicator("ok", "Новый профиль");
            if (manual) addLog("ℹ️ В облаке еще нет записи для этого TG ID, создаем новую...", "info");
            saveToSupabase(false);
          }
        } else {
          setCloudIndicator("err", "Локальный сейв");
        }
      } catch (e) {
        setCloudIndicator("err", "Локальный сейв");
      }
    }

    function openCloudModal() {
      document.getElementById("cloudModal").classList.add("open");
    }
    function closeCloudModal() {
      document.getElementById("cloudModal").classList.remove("open");
    }

    /********************************************************************
     * 11. BOOTSTRAP
     ********************************************************************/
    window.addEventListener("DOMContentLoaded", () => {
      initTelegramApp();
      nextCustomer();
      loadFromSupabase(false);
    });
  </script>
</body>
