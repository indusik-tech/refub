        hinge: "механизм складывания/вибро хрустит",
        port: "зарядка Type-C отходит, только под углом ловит"
      };
      const symptoms = brokenParts.map(k => map[k]).join(", плюс ");
      return `«Здарова! На моем ${modelTitle} беда: ${symptoms}. Починишь или проще выкинуть?»`;
