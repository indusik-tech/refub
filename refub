    function togglePhonePower() {
      if (!phone) return;
      if (!phone.parts.battery.installed || !phone.batteryConnected) {
        addLog("⚠️ Невозможно включить: аккумулятор отключен или снят!", "warn");
        phone.poweredOn = false;
        renderWorkbenchState();
        return;
      }
      if (phone.parts.board.status !== "ok" || phone.parts.battery.status !== "ok") {
        addLog("⚠️ Телефон не стартует: неисправна плата или аккумулятор!", "bad");
        playSound("zap");
        phone.poweredOn = false;
        renderWorkbenchState();
        return;
      }
      phone.poweredOn = !phone.poweredOn;
      playSound("pop");
      addLog(phone.poweredOn ? "⚡ Питание смартфона ВКЛЮЧЕНО." : "⚡ Питание смартфона ВЫКЛЮЧЕНО.", "info");
      renderWorkbenchState();
    }

    function handleScrewClick(idx, ev) {
      ev.stopPropagation();
      if (activeTool !== "screwdriver") {
        addLog("🪛 Чтобы крутить нижние винты, выбери «Отвертку»!", "warn");
        return;
      }
      if (phone.screws[idx]) {
        phone.screws[idx] = false;
        playSound("screw");
        addLog(`🪛 Нижний винт #${idx + 1} выкручен.`, "info");
      } else {
        if (phone.screenRemoved) {
          addLog("⚠️ Сначала закрой дисплей кнопкой «Закрыть экран», затем закручивай винты!", "warn");
          return;
        }
        phone.screws[idx] = true;
        playSound("screw");
        addLog(`🪛 Нижний винт #${idx + 1} закручен на место.`, "good");
      }
      renderWorkbenchState();
    }

    function handleOverlayClick(ev) {
      if (!phone) return;
      const rect = ev.currentTarget.getBoundingClientRect();
      const x = ((ev.clientX - rect.left) / rect.width) * 380;
      const y = ((ev.clientY - rect.top) / rect.height) * 430;

      if (["hammer", "torch", "taser", "drill"].includes(activeTool)) {
        applyRageTool(activeTool, x, y);
        return;
      }

      if (activeTool === "heatgun") {
        phone.temp = Math.min(260, phone.temp + 18);
        playSound("solder");
        if (phone.temp >= 75 && phone.temp <= 110) {
          addLog(`🌡️ Отлично! Клей прогрет до ${phone.temp}°C — можно снимать экран Присоской!`, "good");
        } else if (phone.temp > 120) {
          phone.parts.screen.status = "broken";
          drawBurn(x, y, 28);
          addLog(`🔥 ПЕРЕГРЕВ (${phone.temp}°C)! Ты сжег поляризатор OLED матрицы!`, "bad");
        }
        renderWorkbenchState();
        return;
      }

      if (activeTool === "suction") {
        if (phone.screws[0] || phone.screws[1]) {
          addLog("⚠️ Нельзя снять экран! Сначала выкрути оба нижних винта Отверткой.", "warn");
          return;
        }
        if (phone.temp < 70 && phone.sealApplied) {
          addLog(`⚠️ Герметик слишком холодный (${phone.temp}°C)! Прогрей Феном хотя бы до 75°C, иначе порвешь экран.`, "warn");
          return;
        }
        phone.screenRemoved = true;
        phone.sealApplied = false;
        playSound("pop");
        addLog("🪠 Дисплейный модуль аккуратно отсоединен! Не забудь отключить клемму АКБ перед ремонтом.", "good");
        renderWorkbenchState();
        return;
      }
    }

    function handleScreenClick(ev) {
      handleOverlayClick(ev);
    }

    function toggleBatteryConnector(ev) {
      ev.stopPropagation();
      if (!phone.screenRemoved) return;
      phone.batteryConnected = !phone.batteryConnected;
      if (!phone.batteryConnected) phone.poweredOn = false;
      playSound("pop");
      addLog(
        phone.batteryConnected
          ? "🔌 Клемма аккумулятора подключена к плате."
          : "🔌 Клемма аккумулятора безопасно отстегнута. Плата обесточена.",
        phone.batteryConnected ? "info" : "good"
      );
      renderWorkbenchState();
    }

    function handleSlotClick(slotKey) {
      if (!phone || !phone.screenRemoved) return;

      if (["hammer", "torch", "taser", "drill"].includes(activeTool)) {
        applyRageTool(activeTool, 190, 210);
        return;
      }

      if (activeTool === "glue") {
        phone.sealApplied = true;
        playSound("pop");
        addLog("💧 Водозащитный герметик нанесен по периметру корпуса.", "good");
        renderWorkbenchState();
        return;
      }

      if (phone.batteryConnected && slotKey !== "battery" && (activeTool === "tweezers" || activeTool === "solder")) {
        phone.parts.board.status = "broken";
        playSound("zap");
        drawLightning(190, 140);
        addLog("⚡ КОРОТКОЕ ЗАМЫКАНИЕ! Ты полез металлическим инструментом при неотключенной клемме АКБ и спалил плату!", "bad");
        renderWorkbenchState();
        return;
      }

      const part = phone.parts[slotKey];

      if (activeTool === "solder") {
        if ((slotKey === "board" || slotKey === "port") && part.installed && part.status === "broken") {
          part.status = "ok";
          playSound("solder");
          addLog(`♨️ Микропайка успешна! Узел «${PART_TYPES[slotKey].name}» восстановлен без замены!`, "good");
          renderWorkbenchState();
        } else {
          addLog("♨️ Паяльником можно восстановить только установленную сломанную Плату или Порт USB-C.", "warn");
        }
        return;
      }

      if (activeTool === "tweezers") {
        if (part.installed) {
          part.installed = false;
          if (slotKey === "battery") phone.batteryConnected = false;
          playSound("pop");
          addLog(`镊 Снят модуль: ${PART_TYPES[slotKey].name}. Кликни еще раз, чтобы поставить новый со склада.`, "info");
        } else {
          installPartFromInventory(slotKey);
        }
        renderWorkbenchState();
        return;
      }

      addLog("ℹ️ Выбери «Пинцет» для снятия/установки детали или «Паяльник» для перепайки.", "info");
    }

    function installPartFromInventory(slotKey) {
      const oemKey = `${slotKey}_oem`;
      const copyKey = `${slotKey}_copy`;
      let usedQuality = null;

      if (state.inventory[oemKey] > 0) {
        state.inventory[oemKey]--;
        usedQuality = "oem";
      } else if (state.inventory[copyKey] > 0) {
        state.inventory[copyKey]--;
        usedQuality = "copy";
      } else {
        addLog(`❌ На складе нет детали «${PART_TYPES[slotKey].name}»! Купи её справа в магазине.`, "bad");
        return;
      }

      phone.parts[slotKey].installed = true;
      phone.parts[slotKey].status = "ok";
      phone.parts[slotKey].quality = usedQuality;
      if (slotKey === "screen") clearCanvasFX();
      playSound("pop");
      addLog(
        `✅ Установлен новый модуль: ${PART_TYPES[slotKey].name} (${usedQuality === "oem" ? "Оригинал OEM" : "Копия Алик"}).`,
        "good"
      );
      renderAll();
    }

    function putScreenBack() {
      if (!phone.screenRemoved) {
        addLog("ℹ️ Экран уже установлен на корпусе.", "info");
        return;
      }
      if (phone.parts.screen.status !== "ok") {
        if (state.inventory.screen_oem > 0) {
          state.inventory.screen_oem--;
          phone.parts.screen.status = "ok";
          phone.parts.screen.quality = "oem";
          clearCanvasFX();
          addLog("✨ Перед установкой автоматически поставлен новый Оригинальный OLED экран со склада!", "good");
        } else if (state.inventory.screen_copy > 0) {
          state.inventory.screen_copy--;
          phone.parts.screen.status = "ok";
          phone.parts.screen.quality = "copy";
          clearCanvasFX();
          addLog("✨ Перед установкой поставлен новый экран (Копия) со склада!", "good");
        }
      }
      phone.screenRemoved = false;
      playSound("pop");
      addLog("📲 Дисплейный модуль защелкнут в корпус. Не забудь закрутить 2 винта Отверткой!", "info");
